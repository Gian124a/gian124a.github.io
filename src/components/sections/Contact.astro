---
import SectionTitle from '../ui/SectionTitle.astro';
import Glow from '../ui/Glow.astro';
import Button from '../ui/Button.astro';
import { socialLinks } from '../../data/navigation';
import { contactInfo, formFields } from '../../data/contact';

---

<section
	id="contacto"
	class="relative mt-10 flex flex-col gap-y-[32px] items-center lg:gap-y-[42px] xl:flex-row xl:min-h-[calc(100vh_-_70px)] xl:px-[70px] xl:justify-between 2xl:px-[140px]"
>
	<article
		class="flex flex-col gap-y-[28px] items-center lg:gap-y-[42px] xl:gap-y-[24px] xl:flex-1 xl:items-start"
	>
		<div
			class="flex flex-col gap-y-3 px-7 items-center lg:order-1 lg:gap-y-5 xl:gap-y-3 xl:items-start xl:p-0 xl:order-1"
		>
			<SectionTitle class="text-center lg:text-start xl:text-start">CONTÁCTAME</SectionTitle>
			<div class="relative lg:w-[80%] xl:w-[70%] 2xl:w-[60%]">
				<p
					class="text-fg text-center text-copy xl:text-start"
				>
					Si tienes una idea para una aplicación móvil, contáctanos. Analizaremos tu concepto y lo
					desarrollaremos. Puedes empezar llenando el formulario, enviando un correo, o por
					WhatsApp.
				</p>
			</div>
		</div>
		<div
			class="flex flex-col gap-y-[15px] md:gap-y-[20px] lg:flex-row lg:gap-x-[25px] lg:order-3 xl:order-2 xl:flex-col xl:items-start xl:w-full"
		>
			{
				contactInfo.map((info) => (
					<div class="flex items-center gap-x-[15px] lg:gap-x-[15px] xl:gap-x-[10px]">
						<div class="size-12 shrink-0 bg-secundary-600 rounded-pill flex justify-center items-center sm:size-14">
							<img
								src={info.icon}
								alt={info.label}
								class="size-5 sm:size-7"
							/>
						</div>
						<p class="text-fg text-copy min-w-0 break-words">
							{info.text}
						</p>
					</div>
				))
			}
		</div>
		<div
			class="w-fit flex flex-col px-7 sm:px-[10%] gap-y-[15px] lg:order-2 xl:order-3 xl:w-full xl:items-start xl:px-0 xl:justify-start"
		>
			<p
				class="text-fg text-start text-body md:text-lead"
			>
				SÍGUEME
			</p>
			<div class="flex flex-wrap justify-around items-center sm:justify-center gap-2 sm:gap-[10px]">
				{
					socialLinks.map((social) => (
						<a
							href={social.href}
							class:list={[
								'size-(--social-size) shrink-0 bg-secundary-600 rounded-pill flex justify-center items-center',
								'transition-[background-color,transform] duration-(--dur-fast) ease-smooth-out',
								'hover:bg-secundary-700 hover:scale-[1.07]',
							]}
						>
							<img
								src={social.icon}
								alt={social.label}
								class="size-1/2"
							/>
						</a>
					))
				}
			</div>
		</div>
	</article>
	<article class="relative w-full lg:w-[90%] xl:w-[50%]">
		<Glow class="w-[90%] h-[90%] sm:w-full sm:h-full sm:rounded-[10px] opacity-50" />

		<form
			id="contact-form"
			action="https://formspree.io/f/xrbywavq"
			method="POST"
			class="bg-secundary-800 p-[32px] flex flex-col gap-y-[15px] rounded-[30px] sm:flex-row sm:flex-wrap sm:justify-between sm:gap-y-[20px] sm:p-[50px] xl:p-[30px] xl:gap-y-[10px] 2xl:p-[50px] 2xl:gap-y-[25px]"
			novalidate
		>
			{
				formFields.map((field) => (
					<div class="flex flex-col gap-y-[8px] sm:w-[48%]">
						<label
							for={`contact-${field.name}`}
							class="font-medium text-[16px] text-neutral-500 sm:text-[18px] xl:text-[14px]"
						>
							{field.label}
						</label>
						<input
							type={field.type}
							inputmode={field.inputmode}
							id={`contact-${field.name}`}
							name={field.name}
							autocomplete={field.autocomplete}
							required
							aria-required="true"
							aria-invalid="false"
							aria-describedby={`contact-${field.name}-error`}
							class="bg-secundary-600 h-[48px] pl-[15px] text-[14px] rounded-[10px] text-neutral-500 placeholder:text-neutral-700 sm:h-[52px] sm:text-[16px] xl:text-[14px] xl:h-[42px]"
							placeholder={field.placeholder}
						/>
						<div id={`contact-${field.name}-error`} class="error-message text-danger text-xs" aria-live="polite" aria-atomic="true" />
					</div>
				))
			}
			<div class="flex flex-col gap-y-[8px] sm:w-full">
				<label
					for="contact-message"
					class="font-medium text-[16px] text-neutral-500 md:text-[18px] xl:text-[14px]"
				>
					Mensaje
				</label>
				<textarea
					id="contact-message"
					name="message"
					autocomplete="off"
					required
					aria-required="true"
					aria-invalid="false"
					aria-describedby="contact-message-error"
					class="bg-secundary-600 h-[250px] p-[15px] text-[14px] rounded-[10px] text-neutral-500 placeholder:text-neutral-700 resize-none sm:text-[16px] xl:text-[14px] xl:h-[200px] 2xl:h-[230px]"
					placeholder="Escribe un mensaje de lo que desees..."
				></textarea>
				<div id="contact-message-error" class="error-message text-danger text-xs" aria-live="polite" aria-atomic="true"></div>
			</div>
			<div class="sm:w-full flex flex-col items-start gap-y-2">
				<Button
					type="submit"
					size="none"
					shape="control"
					class="w-full h-[48px] text-[14px] sm:text-[16px] sm:h-[52px] lg:w-fit lg:px-[25px] xl:h-[42px] xl:text-[14px]"
				>
					Enviar mensaje
				</Button>
			</div>
		</form>
	</article>
</section>

<script>
	// === LÓGICA DE VALIDACIÓN DEL FORMULARIO DE CONTACTO ===
	interface FieldConfig {
		required: boolean;
		message: string;
		isEmail?: boolean;
		isPhone?: boolean;
		invalidMessage?: string;
	}

	const form = document.getElementById('contact-form') as HTMLFormElement | null;

	if (!form) {
		console.warn("No se encontró el formulario de contacto con el ID 'contact-form'.");
	} else {
		const fields: Record<string, FieldConfig> = {
			name: { required: true, message: 'El nombre completo es obligatorio.' },
			email: {
				required: true,
				isEmail: true,
				message: 'Por favor, introduce un correo electrónico válido.',
			},
			phone: {
				required: true,
				isPhone: true,
				message: 'El teléfono es obligatorio.',
				invalidMessage: 'Por favor, introduce un número de teléfono válido.',
			},
			asunto: { required: true, message: 'El asunto es obligatorio.' },
			message: { required: true, message: 'El mensaje no puede estar vacío.' },
		};

		type FieldElement = HTMLInputElement | HTMLTextAreaElement;

		const validateEmail = (email: string) => {
			const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
			return re.test(String(email).toLowerCase());
		};

		const validatePhone = (phone: string) => {
			const re = /^[+]?[(]?[0-9]{3}[)]?[-\s.]?[0-9]{3}[-\s.]?[0-9]{4,6}$/im;
			return re.test(String(phone));
		};

		const showError = (input: FieldElement, message: string) => {
			const errorContainer = input.parentElement!.querySelector('.error-message')!;
			// Solo escribir si cambia: evita re-anunciar el mismo error en cada pulsación
			if (errorContainer.textContent !== message) errorContainer.textContent = message;
			input.classList.add('input-error');
			input.setAttribute('aria-invalid', 'true');
		};

		const clearError = (input: FieldElement) => {
			const errorContainer = input.parentElement!.querySelector('.error-message')!;
			if (errorContainer.textContent) errorContainer.textContent = '';
			input.classList.remove('input-error');
			input.setAttribute('aria-invalid', 'false');
		};

		const validateField = (input: FieldElement) => {
			const config = fields[input.name];
			let isValid = true;

			if (config.required && !input.value.trim()) {
				showError(input, config.message);
				isValid = false;
			} else if (config.isEmail && !validateEmail(input.value.trim())) {
				showError(input, config.message);
				isValid = false;
			} else if (config.isPhone && input.value.trim() && !validatePhone(input.value.trim())) {
				showError(input, config.invalidMessage!);
				isValid = false;
			} else {
				clearError(input);
			}
			return isValid;
		};

		let toastTimeout: number;
		const showToast = (message: string, type = 'success') => {
			const toast = document.getElementById('toast-notification');
			if (!toast) return;

			clearTimeout(toastTimeout);

			// Reiniciar estado de color
			toast.classList.remove('success', 'error');

			// Errores de envío: alert (asertivo); éxito: status (cortés)
			toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
			toast.setAttribute('aria-live', type === 'error' ? 'assertive' : 'polite');
			toast.textContent = message;
			toast.classList.add(type); // 'success' o 'error'

			// Mostrar el toast con una transición suave
			toast.classList.remove('opacity-0', 'pointer-events-none');
			toast.classList.add('opacity-100', 'pointer-events-auto');

			toastTimeout = window.setTimeout(() => {
				toast.classList.replace('opacity-100', 'opacity-0');
				toast.classList.add('pointer-events-none');
			}, 5000); // Ocultar después de 5 segundos
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault(); // Siempre se maneja con JS

			let isValid = true;
			for (const fieldName in fields) {
				if (!validateField(form.elements.namedItem(fieldName) as FieldElement)) {
					isValid = false;
				}
			}

			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

			if (isValid) {
				const originalButtonText = submitButton.textContent;
				submitButton.disabled = true;
				submitButton.setAttribute('aria-busy', 'true');
				submitButton.textContent = 'Enviando...';

				try {
					const response = await fetch(form.action, {
						method: form.method,
						body: new FormData(form),
						headers: { Accept: 'application/json' },
					});

					if (response.ok) {
						showToast('¡Gracias! Tu mensaje ha sido enviado.', 'success');
						form.reset();
					} else {
						throw new Error('Hubo un problema con el envío.');
					}
				} catch (error) {
					showToast('Error al enviar. Inténtalo de nuevo.', 'error');
				} finally {
					submitButton.disabled = false;
					submitButton.removeAttribute('aria-busy');
					submitButton.textContent = originalButtonText;
				}
			} else {
				// Enfocar el primer campo con error
				const firstErrorField = form.querySelector<HTMLElement>('.input-error');
				if (firstErrorField) firstErrorField.focus();
			}
		});

		// Validar en tiempo real mientras el usuario escribe o sale del campo
		for (const fieldName in fields) {
			const input = form.elements.namedItem(fieldName) as FieldElement;
			input.addEventListener('input', () => validateField(input));
			input.addEventListener('blur', () => validateField(input));
		}
	}
</script>
