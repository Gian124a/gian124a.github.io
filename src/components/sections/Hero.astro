---
import Button from '../ui/Button.astro';
import { socialLinks } from '../../data/navigation';
import { stats } from '../../data/stats';
import { hero } from '../../data/hero';

// Caracteres de la línea más larga del título: el tamaño del h1 se ajusta para que quepa sin partirse
const longest = Math.max(...hero.roleLines.map((l) => l.length));
---

<!--
	Variables del retrato (las usan imagen, texto y márgenes):
	--hero-img-w   ancho del retrato. <lg: fracción del ancho; lg+: escala con la altura de la
	               ventana (75svh / 84svh) con topes por ancho (no invadir el texto) y por
	               "encaje" (retrato + barra de stats caben bajo el header).
	--hero-img-top separación superior del retrato en <lg.
	--hero-copy    escala del botón y márgenes (lg+: escala con el retrato). El párrafo y las descripciones
	               de stats usan --text-copy (global.css).
	--hero-title-size  tamaño final del h1 = min(base, ancho disponible / (caracteres * 0.68)); lo usan el h1
	               y el margen superior del párrafo en <lg.
	--hero-stat    valor de la stat (2.5x copy en <lg). --hero-title: título en lg+ (K1=.095, K2=.024, K3=.062 sobre --hero-img-w).
	--hero-stats-h altura de la barra de stats en lg+ (definida en global.css).
-->
<section
	id="inicio"
	style={`--hero-title-chars:${longest}`}
	class="relative z-50 flex flex-col items-center pt-6 gap-y-4 md:gap-y-8 lg:min-h-[calc(100svh_-_var(--header-h))] lg:justify-end lg:gap-0 lg:pt-0 [--hero-copy:clamp(0.8125rem,0.75rem_+_0.2vw,0.9375rem)] [--hero-stat:calc(var(--hero-copy)*2.2)] sm:[--hero-stat:calc(var(--hero-copy)*2.5)] [--hero-img-w:calc(100vw_-_2rem)] [--hero-img-top:55px] sm:[--hero-img-w:60vw] sm:[--hero-img-top:85px] md:[--hero-img-w:55vw] md:[--hero-img-top:80px] lg:[--hero-copy:clamp(0.875rem,calc(var(--hero-img-w)*0.024),2rem)] lg:[--hero-stat:clamp(2.5rem,calc(var(--hero-img-w)*0.08),6.5rem)] [--hero-title-base:var(--text-display)] [--hero-title-avail:calc(100vw_-_2rem)] sm:[--hero-title-avail:calc(100vw_-_4rem)] [--hero-title-size:min(var(--hero-title-base),calc(var(--hero-title-avail)_/_(var(--hero-title-chars)_*_0.68)))] lg:[--hero-title:clamp(3.5rem,calc(var(--hero-img-w)*0.1),9rem)] lg:[--hero-title-base:var(--hero-title)] lg:[--hero-title-avail:calc(100vw_-_6rem_-_0.78*var(--hero-img-w)_-_1.5rem)] xl:[--hero-title-avail:calc(100vw_-_6rem_-_90px_-_0.78*var(--hero-img-w)_+_1rem)] lg:[--hero-img-w:min(75svh,_50vw,_calc((100svh_-_var(--header-h)_-_var(--hero-stats-h))_/_0.93))] xl:[--hero-img-w:min(84svh,_52vw,_calc((100svh_-_var(--header-h)_-_var(--hero-stats-h))_/_0.93))]"
>
	<!--
		Retrato. <lg: absolute bajo el título, centrado. lg+: absolute a la derecha, con el borde
		inferior de la FIGURA (el SVG tiene ~9.2% de margen transparente abajo = 0.094 * ancho)
		sobre la línea superior de la barra de stats. 1px de solape para evitar rendija.
	-->
	<article
		class="pointer-events-none absolute top-(--hero-img-top) w-(--hero-img-w) z-30 flex lg:right-0 lg:top-auto lg:bottom-[calc(var(--hero-stats-h)_-_0.094*var(--hero-img-w)_-_1px)] lg:z-40"
	>
		<img
			src="/assets/imgs/image-yo.svg"
			alt="Retrato de Gianfranco Muñoz"
			width="402"
			height="411"
			fetchpriority="high"
			class="w-full h-fit object-contain"
		/>
	</article>

	<article
		class="relative w-full flex flex-col gap-y-11 lg:flex-1 lg:justify-center lg:gap-0 xl:px-[45px]"
	>
		<div
			class="w-full flex flex-col items-center sm:px-[10%] md:px-[5%] lg:items-start lg:px-0 lg:h-fit lg:mb-[calc(var(--hero-img-w)*0.05)] lg:max-w-[calc(100%_-_0.9*var(--hero-img-w)_-_1.5rem)] xl:max-w-[calc(100%_-_0.9*var(--hero-img-w)_+_1rem)]"
		>
			<!-- Dos líneas fijas: así la altura del título es predecible (2 × 1.05 × text-display) -->
			<h1
				class="relative z-50 font-extrabold text-[length:var(--hero-title-size)] leading-[1.05] text-center bg-gradient-to-t from-title-from to-title-to bg-clip-text text-transparent lg:text-start lg:mb-[calc(var(--hero-title-size)*0.3)]"
			>
				<span class="block whitespace-nowrap">{hero.roleLines[0]}</span>{" "}<span class="block whitespace-nowrap">{hero.roleLines[1]}</span>
			</h1>

			<!--
				<lg: el párrafo empieza al ~85% del alto del retrato (0.85 = 0.83 * 411/402), medido
				desde su top, descontando el padding de la sección (1.5rem) y las 2 líneas del título.
			-->
			<div
				class="relative z-50 w-[94%] text-center mt-[calc(var(--hero-img-top)_+_0.85*var(--hero-img-w)_-_1.5rem_-_2.1*var(--hero-title-size))] md:w-[70%] lg:mt-0 lg:w-full lg:max-w-[calc(var(--text-copy)*30)] lg:text-start lg:mb-[calc(var(--hero-copy)*1.5)]"
			>
				<p class="text-copy text-fg">
					{hero.intro}
				</p>
			</div>

			<!-- Botón -->
			<div class="relative z-50 mt-10 flex justify-center items-center lg:justify-start lg:mt-0">
				<Button
					href={hero.cta.href}
					size="none"
					class="px-[18px] py-[12px] text-[14px] sm:text-[16px] sm:px-[22px] md:py-[13px] lg:px-[calc(var(--hero-copy)*1.2)] lg:py-[calc(var(--hero-copy)*0.75)] lg:text-[length:var(--hero-copy)]"
				>
					{hero.cta.label}
					<img
						src="/assets/icons/arrow-right.svg"
						class="ml-2 size-[20px] md:size-[24px] lg:size-[calc(var(--hero-copy)*1.3)]"
						alt=""
					/>
				</Button>
			</div>
		</div>

		<div
			class="relative z-50 flex justify-around items-center px-[5px] sm:px-[10%] sm:justify-center sm:gap-x-[25px] lg:w-fit lg:px-0 lg:gap-x-[calc(var(--hero-copy)*0.8)] lg:absolute lg:bottom-[max(1rem,calc(var(--hero-copy)*1.5))]"
		>
			{
				socialLinks.map((social) => (
					<a
						href={social.href}
						class="bg-secundary-600 rounded-full flex shrink-0 justify-center items-center size-(--social-size) hover:bg-secundary-700 hover:scale-[1.07] transition-[background-color,transform] duration-300"
					>
						<img src={social.icon} alt={social.label} class="size-1/2" />
					</a>
				))
			}
		</div>
	</article>

	<!-- Barra de stats: 2×2 en <lg, una sola fila en lg+ (auto-cols-fr: vale para 3, 4 o 5 stats) -->
	<article
		class="bg-secundary-900 flex flex-col w-full gap-y-5 justify-between z-50 lg:h-(--hero-stats-h) lg:gap-y-0"
	>
		<div class="bg-[linear-gradient(to_right,#0C0B0D,#403B45,#403B45,#0C0B0D)] h-[2px] w-full"></div>

		<div class="grid grid-cols-2 gap-y-4 sm:px-[5%] lg:grid-flow-col lg:auto-cols-fr lg:grid-cols-none lg:px-0">
			{
				stats.map((stat) => (
					<div class="flex items-center justify-center gap-x-1 sm:gap-x-3 sm:px-1 lg:gap-x-2">
						<p class="text-[length:var(--hero-stat)] leading-[1.1] font-bold text-fg">{stat.value}</p>
						<p class="text-[length:max(0.6875rem,calc(var(--text-copy)*0.8))] lg:text-[length:max(0.8125rem,calc(var(--text-copy)*0.9))] leading-snug text-fg text-balance max-w-[18ch] line-clamp-2" title={stat.label}>{stat.label}</p>
					</div>
				))
			}
		</div>
		<div class="bg-[linear-gradient(to_right,#0C0B0D,#403B45,#403B45,#0C0B0D)] h-[2px] w-full"></div>
	</article>
</section>
