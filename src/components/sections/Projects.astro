---
import SectionTitle from '../ui/SectionTitle.astro';
import Glow from '../ui/Glow.astro';
import Button from '../ui/Button.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import Modal from '../ui/Modal.astro';
import { projects } from '../../data/projects';
---

<section
	id="proyectos"
	class="mt-10 relative flex flex-col gap-y-10 2xl:h-[calc(100vh_-_70px)] justify-start"
>
	<Glow class="w-full h-[90%] rounded-full opacity-25 sm:w-[80%] md:w-full lg:hidden lg:h-[80%] 2xl:w-[90%]" />

	<article class="flex flex-col gap-y-3 px-7 items-center lg:gap-y-5">
		<SectionTitle class="text-center lg:text-start">PROYECTOS</SectionTitle>
		<div class="relative lg:w-[80%] 2xl:w-[60%]">
			<p
				class="text-fg text-center text-copy"
			>
				A continuación, presento una colección de aplicaciones móviles desarrolladas utilizando
				Flutter y Dart. Estos proyectos demuestran mi capacidad para crear interfaces de usuario de
				alto rendimiento, manejar la lógica de negocio en el lado del cliente y gestionar la
				integración eficiente de APIs para consumir backends preexistentes. Cada proyecto es una
				muestra de funcionalidad, diseño y código limpio.
			</p>
		</div>
	</article>
	<article
		id="projects-scroll-container"
		class="relative flex overflow-x-auto snap-x snap-mandatory no-scrollbar gap-x-4 lg:flex-row lg:flex-wrap lg:overflow-x-visible lg:gap-7 lg:justify-center xl:px-32 2xl:px-64"
	>
		<Glow class="hidden rounded-full opacity-25 w-[70%] h-[90%] md:hidden lg:block lg:w-[85%] lg:h-[60%] xl:w-[90%] 2xl:w-[50%] 2xl:h-full" />

		{projects.map((project) => <ProjectCard project={project} />)}
	</article>

	<article
		id="project-dots-container"
		class="flex justify-center items-center gap-x-2 lg:hidden z-10"
	>
		<!-- Los puntos se generarán aquí con JavaScript (Fase 5) -->
	</article>

	<!-- Modal para Proyectos -->
	<Modal
		id="project-modal-template"
		labelledby="modal-project-title"
		class="rounded-[20px] p-5 w-full max-w-md flex flex-col items-center gap-y-4 max-h-[70vh] overflow-y-auto no-scrollbar sm:max-h-[80vh] lg:max-w-lg xl:max-w-[450px]"
		closeClass="top-5 right-5"
	>
		<div
			class="w-full h-48 rounded-[15px] overflow-hidden flex justify-center items-center flex-shrink-0 sm:h-56 md:h-64"
		>
			<img
				id="modal-project-image"
				src=""
				alt="Imagen del proyecto"
				class="w-full h-full object-cover hidden"
			/>
			<p
				id="modal-project-placeholder"
				class="hidden text-primary-500 font-semibold text-xl xl:text-[14px]"
			>
				En proceso
			</p>
		</div>

		<div class="w-full flex flex-col items-center gap-y-3">
			<h3
				id="modal-project-title"
				class="text-neutral-500 text-xl text-center font-semibold lg:text-2xl"
			>
			</h3>
			<p
				id="modal-project-description"
				class="text-neutral-600 text-sm text-center md:text-base xl:text-[12px]"
			>
			</p>
		</div>

		<Button
			id="modal-project-link"
			href="#"
			target="_blank"
			size="none"
			shape="control"
			class="w-full mt-2 px-4 py-3 text-sm md:text-base flex-shrink-0 xl:text-[14px] xl:py-2"
		>
			Ver en GitHub
			<img src="/assets/imgs/github.svg" class="ml-2 size-[18px]" alt="" />
		</Button>
	</Modal>
</section>

<script>
	import { setupCarousel } from "../../scripts/carousel";
	import { setupModal } from "../../scripts/modal";

	setupCarousel("projects-scroll-container", "project-dots-container", ".project-card");

	const modalImage = document.getElementById("modal-project-image") as HTMLImageElement | null;
	const modalPlaceholder = document.getElementById("modal-project-placeholder");
	const modalTitle = document.getElementById("modal-project-title");
	const modalDescription = document.getElementById("modal-project-description");
	const modalLink = document.getElementById("modal-project-link") as HTMLAnchorElement | null;

	setupModal({
		modalId: "project-modal-template",
		openSelector: ".open-project-modal-btn",
		cardSelector: ".project-card",
		label: "proyectos",
		fill: (card) => {
			const imageSrc = card.querySelector<HTMLImageElement>(".project-image")?.src; // .src solo existe en <img>
			const titleText = card.querySelector(".project-title")?.textContent;
			const descriptionText = card.querySelector(".project-description")?.textContent;
			const projectUrl = card.dataset.projectUrl;

			if (modalImage) modalImage.alt = `Capturas de la app ${titleText ?? ""}`.trim();

			if (imageSrc && modalImage && modalPlaceholder) {
				// Si hay imagen, la mostramos y ocultamos el texto
				modalImage.src = imageSrc;
				modalImage.classList.remove("hidden");
				modalPlaceholder.classList.add("hidden");
			} else if (modalImage && modalPlaceholder) {
				// Si no hay imagen, ocultamos la imagen y mostramos el texto
				modalImage.classList.add("hidden");
				modalPlaceholder.classList.remove("hidden");
			}

			if (modalTitle) modalTitle.textContent = titleText || "Sin título";
			if (modalDescription) modalDescription.textContent = descriptionText || "Sin descripción.";
			if (modalLink) {
				modalLink.href = projectUrl || "#";
				// Ocultar el botón si no hay URL
				modalLink.style.display = projectUrl && projectUrl !== "#" ? "flex" : "none";
			}
		},
	});
</script>
