---
import SectionTitle from '../ui/SectionTitle.astro';
import Glow from '../ui/Glow.astro';
import Modal from '../ui/Modal.astro';
import { timeline } from '../../data/experience';
---

<section
	id="experiencias"
	class="relative py-10 flex flex-col gap-y-8 lg:py-10 lg:px-12 xl:px-24 lg:min-h-[calc(100svh_-_var(--header-h))] lg:justify-center [--exp-title:clamp(0.875rem,2.5svh,1.25rem)] [--exp-meta:clamp(0.6875rem,1.8svh,1rem)] [--exp-pad:clamp(0.5rem,1.6svh,1rem)]"
>
	<Glow blur="100" class="w-[80%] h-[80%] rounded-full opacity-20 sm:hidden md:block lg:hidden" />

	<article
		id="scroll-container"
		class="relative flex overflow-x-auto snap-x snap-mandatory no-scrollbar lg:flex-row lg:overflow-x-visible lg:snap-none lg:justify-center lg:items-start"
	>
		{
			timeline.map((category, index) => (
				<div
					id={`section-${category.id}`}
					data-timeline-panel
					class="relative flex-col gap-y-[24px] w-full flex-none snap-start flex items-center md:gap-y-[32px] lg:gap-y-4 lg:flex-1 lg:basis-0 lg:min-w-0 lg:w-auto"
				>
					<Glow
						class:list={[
							'hidden sm:block w-[70%] h-[90%] rounded-full md:hidden lg:block lg:w-[85%] xl:w-[90%] 2xl:w-[70%]',
							index % 2 === 0 ? 'sm:opacity-30' : 'sm:opacity-20',
						]}
					/>

					<SectionTitle as="h2" class="text-center lg:text-start">
						{category.heading}
					</SectionTitle>

					<div class="relative flex flex-col items-center gap-y-[16px] w-[94%] max-w-[340px] sm:max-w-[420px] md:max-w-[490px] md:gap-y-[32px] lg:max-w-[calc(var(--exp-title)*24)] lg:gap-y-(--exp-pad) xl:max-w-[calc(var(--exp-title)*26)]">
						{category.items.map((item) => (
							<button
								type="button"
								aria-label={`Ver detalle: ${item.title}`}
								data-year={item.year}
								data-title={item.title}
								data-place={item.place}
								data-description={item.description}
								class="timeline-card open-timeline-modal-btn relative w-full min-w-0 text-start cursor-pointer bg-surface-raised rounded-card py-[12px] pl-[16px] pr-[44px] flex flex-col items-start gap-y-[4px] transition-[background-color] duration-(--dur-fast) ease-smooth-out hover:bg-secundary-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg sm:gap-y-[8px] md:gap-y-[6px] md:py-[23px] md:pl-[22px] lg:py-(--exp-pad) lg:gap-y-[calc(var(--exp-pad)*0.25)]"
							>
								<p class="text-accent-fg text-small font-semibold lg:text-[length:var(--exp-meta)]">{item.year}</p>
								<p class="w-full truncate text-lead font-bold text-fg lg:text-[length:var(--exp-title)]">{item.title}</p>
								<p class="w-full truncate text-small text-fg-subtle font-semibold lg:text-[length:var(--exp-meta)]">{item.place}</p>
								<img src="/assets/icons/arrow-right.svg" alt="" class="absolute right-4 top-1/2 size-[18px] -translate-y-1/2 opacity-70" />
							</button>
						))}
					</div>
				</div>
			))
		}
	</article>
	<article class="flex justify-center items-center gap-x-2 lg:hidden">
		{
			timeline.map((_, index) => (
				<div
					data-timeline-dot
					class:list={[
						'w-4 h-4 rounded-full transition-[background-color,transform] duration-(--dur-fast) ease-smooth-out',
						index === 0 ? 'bg-dot-active' : 'bg-dot',
					]}
				/>
			))
		}
	</article>

	<!-- Modal con el detalle de cada entrada -->
	<Modal
		id="timeline-modal"
		labelledby="modal-timeline-title"
		class="rounded-[30px] p-8 max-w-lg max-h-[80vh] w-full flex flex-col gap-y-3"
		closeClass="top-3 right-3"
	>
		<div class="flex flex-col gap-y-1 pr-8">
			<p id="modal-timeline-year" class="text-accent-fg text-small font-semibold"></p>
			<h3 id="modal-timeline-title" class="text-fg text-subtitle font-bold"></h3>
			<p id="modal-timeline-place" class="text-fg-subtle text-small font-semibold"></p>
		</div>
		<div class="overflow-y-auto no-scrollbar">
			<p id="modal-timeline-description" class="text-fg text-body"></p>
		</div>
	</Modal>
</section>

<script>
	import { setupModal } from '../../scripts/modal';

	const field = (id: string) => document.getElementById(id);
	setupModal({
		modalId: 'timeline-modal',
		openSelector: '.open-timeline-modal-btn',
		cardSelector: '.timeline-card',
		label: 'experiencia',
		fill: (card) => {
			const set = (id: string, text?: string) => {
				const el = field(id);
				if (el) el.textContent = text ?? '';
			};
			set('modal-timeline-year', card.dataset.year);
			set('modal-timeline-title', card.dataset.title);
			set('modal-timeline-place', card.dataset.place);
			set('modal-timeline-description', card.dataset.description);
		},
	});

	// === PUNTOS DE ESTADO: un punto por panel, enlazados por índice ===
	const scrollContainer = document.getElementById('scroll-container');
	const panels = Array.from(
		document.querySelectorAll<HTMLElement>('#scroll-container [data-timeline-panel]'),
	);
	const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-dot]'));

	if (scrollContainer && panels.length && panels.length === dots.length) {
		const setActiveDot = (activeIndex: number) => {
			dots.forEach((dot, i) => {
				dot.classList.toggle('bg-dot-active', i === activeIndex);
				dot.classList.toggle('bg-dot', i !== activeIndex);
			});
		};

		// 0.9 asegura que el snap ya terminó
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) setActiveDot(panels.indexOf(entry.target as HTMLElement));
				});
			},
			{ root: scrollContainer, rootMargin: '0px', threshold: 0.9 },
		);

		panels.forEach((panel) => observer.observe(panel));
	} else {
		console.error('Experience: paneles o puntos de estado no coinciden.');
	}
</script>
