---
import { brand } from '../data/navigation';
---

<header
	data-site-header
	class="fixed inset-x-0 top-0 z-(--z-header) flex h-(--header-h) items-center justify-between border-b border-white/5 bg-surface/85 px-4 backdrop-blur-md sm:px-8 lg:px-11 2xl:px-24"
>
	<a
		id="brand-logo"
		href="#inicio"
		aria-label="Portfolio de Gianfranco Muñoz, ir al inicio"
		class="rounded-md bg-gradient-to-t from-title-from to-title-to bg-clip-text text-[28px] font-extrabold text-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg md:text-[30px]"
	>
		{brand}
	</a>

	<button
		id="menu-button"
		type="button"
		aria-label="Abrir menú"
		aria-expanded="false"
		aria-controls="menu-container"
		class="rounded-md p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg lg:hidden"
	>
		<img id="button-menu" src="/assets/icons/bar.svg" class="size-[25px] transform" alt="" />
	</button>

	<a
		href="#contacto"
		class="hidden items-center rounded-[100px] bg-primary-500 px-4 py-[9px] text-[14px] font-medium text-neutral-500 duration-300 hover:bg-primary-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg lg:flex"
	>
		Contacto
		<img src="/assets/icons/card.svg" class="ml-2 size-[20px] text-neutral-500" alt="" />
	</a>
</header>

<script>
	// === HEADER QUE SE OCULTA AL BAJAR (solo < lg; el movimiento y la media query viven en styles.css) ===
	// Solo alterna data-hidden. Escucha scroll (nativo o Lenis, que también mueve window) con rAF; sin JS el header siempre se ve.
	const header = document.querySelector<HTMLElement>('[data-site-header]')!;
	const menuButton = document.getElementById('menu-button');
	const THRESHOLD = 8; // px de movimiento acumulado para cambiar de estado (evita parpadeo por micro-scroll)
	let last = Math.max(0, window.scrollY);
	let ticking = false;

	function update() {
		ticking = false;
		const y = Math.max(0, window.scrollY); // rebote elástico de iOS da valores negativos
		const atBottom = y + window.innerHeight >= document.documentElement.scrollHeight - 2;
		const menuOpen = menuButton?.getAttribute('aria-expanded') === 'true';

		const anchorScroll = 'anchorScroll' in document.documentElement.dataset; // scroll por ancla (lenis.ts)

		if (menuOpen || atBottom || anchorScroll || y < header.offsetHeight * 2) {
			header.removeAttribute('data-hidden');
			last = y;
			return;
		}
		const dy = y - last;
		if (Math.abs(dy) < THRESHOLD) return;
		header.toggleAttribute('data-hidden', dy > 0);
		last = y;
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true },
	);
</script>
