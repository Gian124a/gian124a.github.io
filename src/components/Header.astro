---
import { brand } from '../data/navigation';
---

<header
	class="fixed inset-x-0 top-0 z-(--z-header) flex h-(--header-h) items-center justify-between border-b border-white/5 bg-surface/85 px-4 backdrop-blur-md sm:px-8 lg:px-11 2xl:px-24"
>
	<a
		id="brand-logo"
		href="#inicio"
		aria-label="Portfolio de Gianfranco Muñoz, ir al inicio"
		class="rounded-md bg-gradient-to-t from-title-from to-title-to bg-clip-text text-[28px] font-extrabold text-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg md:text-[30px]"
	>
		{brand}
	</a>

	<button
		id="menu-button"
		type="button"
		aria-label="Abrir menú"
		aria-expanded="false"
		aria-controls="menu-container"
		class="rounded-md p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg lg:hidden"
	>
		<img id="button-menu" src="/assets/icons/bar.svg" class="size-[25px] transform" alt="" />
	</button>

	<a
		href="#contacto"
		class="hidden items-center rounded-[100px] bg-primary-500 px-4 py-[9px] text-[14px] font-medium text-neutral-500 duration-300 hover:bg-primary-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg lg:flex"
	>
		Contacto
		<img src="/assets/icons/card.svg" class="ml-2 size-[20px] text-neutral-500" alt="" />
	</a>
</header>
