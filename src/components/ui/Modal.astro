---
// Cáscara genérica de modal sobre <dialog> nativo (showModal => aria-modal, foco atrapado, resto inert).
// La lógica de abrir/cerrar/animar vive en src/scripts/modal.ts (setupModal).
// - id: id del <dialog>
// - labelledby: id del elemento título dentro del slot (aria-labelledby)
// - class: clases del panel visible (tamaño, radios, padding, scroll interno)
// - closeClass: posición del botón cerrar dentro del panel (por defecto esquina sup. derecha)
interface Props {
	id: string;
	labelledby: string;
	class?: string;
	closeClass?: string;
}

const { id, labelledby, class: className, closeClass = 'top-3 right-3' } = Astro.props;
---

<dialog id={id} aria-labelledby={labelledby} data-modal>
	<div data-modal-panel data-lenis-prevent class:list={['relative bg-surface-overlay', className]}>
		<button
			type="button"
			data-modal-close
			aria-label="Cerrar"
			class:list={[
				'absolute z-10 size-10 flex items-center justify-center rounded-full cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg',
				closeClass,
			]}
		>
			<img src="/assets/imgs/logo-close.svg" alt="" width="24" height="24" />
		</button>
		<slot />
	</div>
</dialog>

<style>
	dialog[data-modal] {
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 1rem;
		border: 0;
		background: transparent;
		color: inherit;
		overflow: hidden;
	}
	dialog[data-modal][open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Panel: entrada fade + escala (base/drawer); salida más rápida */
	[data-modal-panel] {
		opacity: 1;
		transform: scale(1);
		transition:
			opacity var(--dur-base) var(--ease-drawer),
			transform var(--dur-base) var(--ease-drawer);
	}
	@starting-style {
		dialog[data-modal][open] [data-modal-panel] {
			opacity: 0;
			transform: scale(0.95);
		}
	}
	dialog[data-modal][data-closing] [data-modal-panel] {
		opacity: 0;
		transform: scale(0.95);
		transition-duration: var(--dur-fast);
		transition-timing-function: var(--ease-smooth-out);
	}

	/* Fondo: mismo aspecto que el overlay anterior de Proyectos */
	dialog[data-modal]::backdrop {
		background: color-mix(in oklab, var(--color-secundary-900) 30%, transparent);
		backdrop-filter: blur(12px);
		opacity: 1;
		transition: opacity var(--dur-base) var(--ease-drawer);
	}
	@starting-style {
		dialog[data-modal][open]::backdrop {
			opacity: 0;
		}
	}
	dialog[data-modal][data-closing]::backdrop {
		opacity: 0;
		transition-duration: var(--dur-fast);
		transition-timing-function: var(--ease-smooth-out);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-modal-panel],
		dialog[data-modal][data-closing] [data-modal-panel] {
			transform: none;
			transition-property: opacity;
			transition-duration: var(--dur-instant);
		}
		@starting-style {
			dialog[data-modal][open] [data-modal-panel] {
				transform: none;
			}
		}
		dialog[data-modal]::backdrop,
		dialog[data-modal][data-closing]::backdrop {
			transition-duration: var(--dur-instant);
		}
	}
</style>

<style is:global>
	/* Bloqueo de scroll del fondo sin salto de layout */
	html.modal-open {
		overflow: hidden;
		scrollbar-gutter: stable;
	}
</style>
