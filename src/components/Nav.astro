---
import { navLinks } from '../data/navigation';

// Todos los enlaces comparten clases; el escalonado usa --i (ver styles.css)
const linkClass =
	'relative z-10 px-[40px] py-[13px] text-[14px] text-neutral-500 transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-fg sm:px-[45px] sm:py-[15px] md:px-[50px] md:py-[18px] lg:rounded-[100px] lg:px-[17px] lg:py-[6px]';
---

<nav
	class="fixed top-[calc(var(--header-h)+12px)] right-3 z-(--z-nav) w-fit lg:pointer-events-none lg:inset-x-0 lg:top-0 lg:mx-auto lg:flex lg:h-(--header-h) lg:w-full lg:items-center lg:justify-center"
>
	<div
		id="menu-container"
		class="relative flex flex-col items-center p-[6px] overflow-hidden rounded-[12px] bg-gradient-to-b from-secundary-800 to-secundary-600 backdrop-blur-xl shadow-lg lg:pointer-events-auto lg:flex-row lg:gap-2 lg:p-1 lg:rounded-full lg:border lg:border-neutral-700 lg:backdrop-blur-sm"
	>
		<!-- Fondo animado: ocupa todo el contenedor y se recorta con clip-path (lo fija el script; sin JS queda oculto) -->
		<span
			id="active-bg"
			class="pointer-events-none absolute inset-0 z-[1] bg-secundary-500/70 backdrop-blur-md [clip-path:inset(50%)] lg:bg-secundary-600"
		></span>

		<!-- Botones -->
		{
			navLinks.map((link, i) => (
				<a
					href={link.href}
					style={`--i:${i}`}
					class:list={[linkClass, link.mobileOnly && 'lg:hidden']}
				>
					{link.label}
				</a>
			))
		}
	</div>
</nav>

<script>
	import { scrollToTarget } from '../scripts/motion/lenis';
	import { gsap } from '../scripts/motion/gsap';
	import { getTier } from '../scripts/motion/tiers';
	import { dur } from '../scripts/motion/tokens';

	// === MENÚ, FONDO ACTIVO, SCROLLSPY Y SCROLL SUAVE ===
	const menu = document.getElementById('menu-container') as HTMLElement;
	const activeBg = document.getElementById('active-bg') as HTMLElement;
	const links = menu.querySelectorAll<HTMLAnchorElement>('a');
	const menuButton = document.getElementById('menu-button') as HTMLButtonElement;
	let userClicked = false;
	let clickTimeout: number;

	// --- Controla el movimiento del fondo activo ---
	// El fondo mide siempre lo mismo que el contenedor; solo cambia el recorte (sin layout).
	const pill = { t: 0, r: 0, b: 0, l: 0 };
	function paintPill(radius: number) {
		activeBg.style.clipPath = `inset(${pill.t}px ${pill.r}px ${pill.b}px ${pill.l}px round ${radius}px)`;
	}

	// animate=false: posición directa (primera colocación y resize); true: spring según el nivel
	function moveBgTo(link: HTMLAnchorElement, animate = false) {
		// Vertical (móvil) u horizontal, según el estilo computado (más fiable que el ancho de ventana)
		const isMobile = window.getComputedStyle(menu).flexDirection === 'column';
		const inset = 4; // margen visual contra el borde del contenedor
		const radius = isMobile ? 10 : 100;
		const W = menu.clientWidth;
		const H = menu.clientHeight;
		const to = isMobile
			? { t: link.offsetTop, r: inset, b: H - link.offsetTop - link.offsetHeight, l: inset }
			: { t: inset, r: W - link.offsetLeft - link.offsetWidth, b: inset, l: link.offsetLeft };

		const tier = getTier();
		gsap.killTweensOf(pill);
		if (!animate || tier === 'reduced') {
			Object.assign(pill, to);
			paintPill(radius);
			return;
		}
		gsap.to(pill, {
			...to,
			duration: tier === 'full' ? 0.45 : dur.base,
			ease: tier === 'full' ? 'back.out(1.4)' : 'power3.out',
			overwrite: 'auto',
			onUpdate: () => paintPill(radius),
		});
	}

	// --- Marca un link como activo ---
	function activateLink(link: HTMLAnchorElement) {
		links.forEach((l) => {
			l.classList.remove('active', 'pointer-events-none');
			l.removeAttribute('aria-current');
		});
		link.classList.add('active', 'pointer-events-none');
		link.setAttribute('aria-current', 'true');

		// Si el link está oculto en este ancho (p. ej. "Contacto" en escritorio, que ya tiene
		// su botón en el header), la pill sube y se oculta; vuelve al llegar a otra sección.
		const hidden = link.offsetParent === null;
		menu.classList.toggle('nav-hidden', hidden);
		if (!hidden) moveBgTo(link, true);
	}

	// --- Abre / cierra el menú móvil y sincroniza ARIA ---
	function setMenu(open: boolean) {
		menu.classList.toggle('open', open);
		menuButton.setAttribute('aria-expanded', String(open));
		menuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
	}

	// --- Evento de clic en los links ---
	links.forEach((link) => {
		link.addEventListener('click', (e) => {
			e.preventDefault();

			// Desactiva temporalmente el scrollspy mientras dura el scroll suave
			userClicked = true;
			clearTimeout(clickTimeout);
			const release = () => {
				clearTimeout(clickTimeout);
				userClicked = false;
			};
			clickTimeout = window.setTimeout(release, 2500); // respaldo si la Promise nunca resuelve

			activateLink(link);
			const target = document.getElementById(link.getAttribute('href')!.substring(1));
			if (target) scrollToTarget(target).then(release, release);
			else release();

			// Si está en móvil, cierra el menú al seleccionar
			if (window.innerWidth < 1024) setMenu(false);
		});
	});

	// --- Actualiza el link activo mientras se hace scroll ---
	function updateActiveLinkOnScroll() {
		const sections = Array.from(links)
			.map((link) => {
				const id = link.getAttribute('href')?.substring(1);
				return id ? document.getElementById(id) : null;
			})
			.filter(Boolean) as HTMLElement[];

		const observer = new IntersectionObserver(
			(entries) => {
				if (userClicked) return;

				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const correspondingLink = menu.querySelector<HTMLAnchorElement>(
							`a[href="#${entry.target.id}"]`,
						);
						if (correspondingLink) activateLink(correspondingLink);
					}
				});
			},
			// Activa cuando el centro de la sección cruza el centro de la pantalla
			{ root: null, rootMargin: '-50% 0px -50% 0px', threshold: 0 },
		);

		sections.forEach((section) => observer.observe(section));
	}

	// --- Arranca el scrollspy en cuanto el DOM está listo (no espera a imágenes con window.load) ---
	activateLink(links[0]);
	moveBgTo(links[0]); // primera colocación directa (activateLink anima)
	updateActiveLinkOnScroll();
	// Recoloca el fondo sin animar (si el link activo está oculto en este ancho, no hay nada que medir)
	function placeActive() {
		const activeLink = document.querySelector<HTMLAnchorElement>('a.active') || links[0];
		if (activeLink.offsetParent !== null) moveBgTo(activeLink);
	}
	// Recoloca el fondo cuando ya cargó la fuente (cambia el ancho de los links)
	document.fonts.ready.then(() => {
		placeActive();
	});

	// --- Reajusta la posición al redimensionar ---
	window.addEventListener('resize', placeActive);

	// --- Abre / Cierra menú en móviles ---
	menuButton.addEventListener('click', () => {
		setMenu(!menu.classList.contains('open'));
	});

	// --- Escape cierra el menú y devuelve el foco al botón ---
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menu.classList.contains('open')) {
			setMenu(false);
			menuButton.focus();
		}
	});
</script>
