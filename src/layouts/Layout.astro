---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/styles.css';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Portfolio',
	description = 'Gianfranco Muñoz, TSU en Informática y desarrollador frontend especializado en aplicaciones móviles híbridas con Flutter y Dart. Conoce mis proyectos, experiencia y habilidades.',
	image = '/og-image.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font
			cssVariable="--font-poppins"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 800, style: 'normal' },
			]}
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0b0d" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Gianfranco Muñoz" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Gianfranco Muñoz, desarrollador frontend" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
	</head>
	<body class="relative bg-secundary-900 font-sans min-h-screen overflow-x-hidden">
		<!-- Pantalla de Carga -->
		<div
			id="loader"
			class="fixed inset-0 z-[9999] flex items-center justify-center bg-secundary-900 transition-opacity duration-500 ease-in-out"
		>
			<div
				class="loader-spinner h-16 w-16 rounded-full border-4 border-solid border-primary-500"
			>
			</div>
		</div>

		<!-- Contenedor para la notificación Toast (inicialmente invisible para permitir transición) -->
		<div
			id="toast-notification"
			role="status"
			aria-live="polite"
			aria-atomic="true"
			class="opacity-0 pointer-events-none fixed top-5 left-0 right-0 mx-auto w-fit p-4 rounded-lg shadow-lg transition-opacity duration-300 z-[300] sm:left-auto sm:right-5"
		>
		</div>

		<Header />
		<Nav />
		<slot />
		<Footer />

		<script>
			// === LÓGICA DE LA PANTALLA DE CARGA ===
			window.addEventListener('load', () => {
				const loader = document.getElementById('loader');
				if (loader) {
					// Ocultar el loader con una transición suave
					loader.classList.add('opacity-0');

					// Después de la transición, ocultarlo completamente para que no interfiera
					setTimeout(() => {
						loader.style.display = 'none';
					}, 500); // Debe coincidir con la duración de la transición
				}
			});
		</script>
	</body>
</html>
