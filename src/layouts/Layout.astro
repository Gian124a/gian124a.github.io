---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/styles.css';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Portfolio',
	description = 'Gianfranco Muñoz, TSU en Informática y desarrollador frontend especializado en aplicaciones móviles híbridas con Flutter y Dart. Conoce mis proyectos, experiencia y habilidades.',
	image = '/og-image.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font
			cssVariable="--font-poppins"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 800, style: 'normal' },
			]}
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0b0d" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Gianfranco Muñoz" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Gianfranco Muñoz, desarrollador frontend" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<script is:inline>
			// Único sitio que decide mostrar el loader (sin JS nunca se muestra: CSS lo oculta por defecto).
			// V3: aquí se decidirá la intro de primera visita por sesión con sessionStorage.
			document.documentElement.classList.add('has-loader');
		</script>
	</head>
	<body class="relative bg-secundary-900 font-sans min-h-screen overflow-x-clip">
		<!-- Pantalla de Carga -->
		<div
			id="loader"
			aria-hidden="true"
			class="fixed inset-0 z-(--z-intro) bg-secundary-900 transition-opacity duration-(--dur-base) ease-smooth-out"
		>
			<div
				class="loader-spinner h-16 w-16 rounded-full border-4 border-solid border-primary-500"
			>
			</div>
		</div>

		<!-- Contenedor para la notificación Toast (inicialmente invisible para permitir transición) -->
		<div
			id="toast-notification"
			role="status"
			aria-live="polite"
			aria-atomic="true"
			class="opacity-0 pointer-events-none fixed top-5 left-0 right-0 mx-auto w-fit p-4 rounded-lg shadow-lg transition-opacity duration-300 z-[300] sm:left-auto sm:right-5"
		>
		</div>

		<Header />
		<Nav />
		<slot />
		<Footer />

		<script>
			import { initMotion } from '../scripts/motion';
			initMotion();
		</script>

		<script>
			// === LOADER: se oculta cuando fuente + imagen LCP están listas (tope 3 s), sin esperar a window.load ===
			const root = document.documentElement;
			const loader = document.getElementById('loader');
			const main = document.querySelector('main');

			if (!loader || !root.classList.contains('has-loader')) {
				root.classList.remove('has-loader');
			} else {
				main?.setAttribute('aria-busy', 'true');

				const lcp = document.querySelector<HTMLImageElement>('#inicio img[fetchpriority="high"]');
				const ready = Promise.all([
					document.fonts.ready.catch(() => {}),
					lcp ? lcp.decode().catch(() => {}) : Promise.resolve(),
				]);
				const timeout = new Promise<void>((resolve) => setTimeout(resolve, 3000));

				let done = false;
				const finish = () => {
					if (done) return;
					done = true;
					loader.style.display = 'none';
					root.classList.remove('has-loader');
					main?.removeAttribute('aria-busy');
				};

				Promise.race([ready, timeout]).then(() => {
					loader.classList.add('opacity-0');
					loader.addEventListener('transitionend', (e) => {
						if (e.target === loader) finish();
					});
					// Respaldo si transitionend no llega (pestaña oculta, sin transición)
					setTimeout(finish, 600);
				});
			}
		</script>
	</body>
</html>
