---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/styles.css';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Portfolio',
	description = 'Gianfranco Muñoz, TSU en Informática y desarrollador frontend especializado en aplicaciones móviles híbridas con Flutter y Dart. Conoce mis proyectos, experiencia y habilidades.',
	image = '/og-image.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font
			cssVariable="--font-poppins"
			preload={[
				{ weight: 400, style: 'normal' },
				{ weight: 800, style: 'normal' },
			]}
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0b0d" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Gianfranco Muñoz" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Gianfranco Muñoz, desarrollador frontend" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<script is:inline>
			// Decide ANTES del primer pintado: hero-pending (estados iniciales de la entrada del hero, siempre que haya JS)
			// e intro-pending (primera visita de la sesión o ?intro, que fuerza para pruebas). Sin JS no se añade nada: todo visible.
			var root = document.documentElement;
			root.classList.add('hero-pending');
			// Nivel no-full (mismos criterios que tiers.ts): el retrato NO se recorta al inicio, así pinta (LCP) bajo la cortina.
			try {
				var nv = navigator, mm = function (q) { return matchMedia(q).matches; };
				if (mm('(prefers-reduced-motion: reduce)') || mm('(pointer: coarse)') || (nv.deviceMemory !== undefined && nv.deviceMemory <= 2) || (nv.hardwareConcurrency !== undefined && nv.hardwareConcurrency <= 2) || (nv.connection && nv.connection.saveData === true)) root.classList.add('hero-lite');
			} catch (e) {}
			// Red de seguridad: si el módulo JS no carga, nadie quita las clases y la página quedaría oculta/tapada.
			// intro.ts / hero.ts las quitan antes (tope duro 3 s + salida + entrada); esto solo actúa como último recurso.
			setTimeout(function () {
				root.classList.remove('intro-pending', 'hero-pending');
			}, 4500);
			try {
				var force = new URLSearchParams(location.search).has('intro');
				if (force || !sessionStorage.getItem('intro-seen')) {
					root.classList.add('intro-pending');
					sessionStorage.setItem('intro-seen', '1');
				}
			} catch (e) {}
		</script>
	</head>
	<body class="relative bg-secundary-900 font-sans min-h-screen overflow-x-clip">
		<Intro />

		<!-- Contenedor para la notificación Toast (inicialmente invisible para permitir transición) -->
		<div
			id="toast-notification"
			role="status"
			aria-live="polite"
			aria-atomic="true"
			class="opacity-0 pointer-events-none fixed top-5 left-0 right-0 mx-auto w-fit p-4 rounded-lg shadow-lg transition-opacity duration-300 z-[300] sm:left-auto sm:right-5"
		>
		</div>

		<Header />
		<Nav />
		<slot />
		<Footer />

		<script>
			import { initMotion } from '../scripts/motion';
			import { runIntro } from '../scripts/motion/intro';
			initMotion();
			runIntro();
		</script>
	</body>
</html>
