---
import { projects } from '../../data/projects';
---

<section
	id="proyectos"
	class="mt-10 relative flex flex-col gap-y-10 2xl:h-[calc(100vh_-_70px)] justify-start"
>
	<div
		class="absolute z-[-1] w-full h-[90%] top-0 left-0 right-0 bottom-0 m-auto rounded-full [background-image:radial-gradient(ellipse_at_center,_#4124AA_0%,_#2A1672_36%,_#21115B_63%,_#1B0E4A_85%,_#05030D_100%)] blur-3xl opacity-25 sm:w-[80%] md:w-full lg:hidden lg:h-[80%] 2xl:w-[90%]"
	>
	</div>

	<article class="flex flex-col gap-y-3 px-7 items-center lg:gap-y-5">
		<h2
			class="font-extrabold text-[9.5vw] leading-[9.5vw] text-center bg-gradient-to-t from-primary-800 to-primary-500 bg-clip-text text-transparent sm:text-[13vh] sm:leading-[13vh] md:text-[6vw] md:leading-[6vw] lg:text-start lg:text-[5.8vh] lg:leading-[5.8vh] xl:text-[6.5vh] xl:leading-[6.5vh] 2xl:text-[52px] 2xl:leading-[56px]"
		>
			PROYECTOS
		</h2>
		<div class="relative lg:w-[80%] 2xl:w-[60%]">
			<p
				class="text-neutral-500 text-center text-[3.8vw] sm:text-[5vh] md:text-[2.2vw] lg:text-[2vh] 2xl:text-[1.6vh]"
			>
				A continuación, presento una colección de aplicaciones móviles desarrolladas utilizando
				Flutter y Dart. Estos proyectos demuestran mi capacidad para crear interfaces de usuario de
				alto rendimiento, manejar la lógica de negocio en el lado del cliente y gestionar la
				integración eficiente de APIs para consumir backends preexistentes. Cada proyecto es una
				muestra de funcionalidad, diseño y código limpio.
			</p>
		</div>
	</article>
	<article
		id="projects-scroll-container"
		class="relative flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth gap-x-4 lg:flex-row lg:flex-wrap lg:overflow-x-visible lg:gap-7 lg:justify-center xl:px-32 2xl:px-64"
	>
		<div
			class="hidden sm:absolute z-[-1] sm:w-[70%] sm:h-[90%] sm:top-0 sm:left-0 sm:right-0 sm:bottom-0 sm:m-auto sm:rounded-full sm:[background-image:radial-gradient(ellipse_at_center,_#4124AA_0%,_#2A1672_36%,_#21115B_63%,_#1B0E4A_85%,_#05030D_100%)] sm:blur-3xl sm:opacity-25 md:hidden lg:flex lg:w-[85%] lg:h-[60%] xl:w-[90%] 2xl:w-[50%] 2xl:h-full"
		>
		</div>

		{
			projects.map((project) => (
				<div
					class="project-card relative flex-col gap-y-[24px] w-full sm:w-[calc(50%_-_8px)] lg:w-fit flex-none lg:flex-initial snap-center sm:snap-start flex items-center justify-center"
					data-project-url={project.url}
				>
					<div class="relative bg-secundary-700 w-[280px] h-[280px] rounded-[20px] p-[14px] gap-y-[15px] flex flex-col md:w-[300px] md:h-[300px] lg:w-[270px] lg:h-[270px] xl:w-[250px] xl:h-[250px]">
						{project.image ? (
							<div class="relative flex-1 rounded-[12px] overflow-hidden bg-secundary-800 flex justify-center items-center">
								<img
									src={project.image}
									alt={`Mockup de ${project.title}`}
									class="project-image absolute left-0 top-0 w-full h-full object-cover"
								/>
							</div>
						) : (
							<div class="project-image relative flex-1 rounded-[12px] overflow-hidden bg-secundary-800 flex justify-center items-center">
								<p class="text-primary-500 font-semibold">En proceso</p>
							</div>
						)}
						<div class="flex justify-between items-center">
							<div class="flex flex-col gap-y-1 lg:gap-0.5">
								<p
									class:list={[
										'project-title text-[16px] text-neutral-500 font-semibold md:text-[18px]',
										project.titleClass,
									]}
								>
									{project.title}
								</p>
								<p class:list={['text-[14px] text-neutral-700', project.typeClass]}>
									{project.type}
								</p>
								<p class="project-description hidden">{project.description}</p>
							</div>
							<button class="open-project-modal-btn cursor-pointer bg-primary-500 w-[40px] h-[40px] rounded-full flex justify-center items-center xl:w-[35px] xl:h-[35px]">
								<img src="/assets/icons/arrow-right.svg" class="size-[22px]" alt="" />
							</button>
						</div>
					</div>
				</div>
			))
		}
	</article>

	<article
		id="project-dots-container"
		class="flex justify-center items-center gap-x-2 lg:hidden z-10"
	>
		<!-- Los puntos se generarán aquí con JavaScript (Fase 5) -->
	</article>

	<!-- Modal para Proyectos -->
	<div
		id="project-modal-template"
		class="fixed inset-0 bg-secundary-900/30 backdrop-blur-md z-[500] p-4 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
	>
		<div
			class="bg-secundary-800 rounded-[20px] p-5 w-full max-w-md relative flex flex-col items-center gap-y-4 transform scale-95 opacity-0 transition-all duration-300 ease-in-out max-h-[70vh] overflow-y-auto no-scrollbar sm:max-h-[80vh] lg:max-w-lg xl:max-w-[450px]"
		>
			<button
				id="close-project-modal-btn"
				aria-label="Cerrar modal"
				class="absolute z-[100] top-6 right-6 p-1 flex items-center justify-center rounded-full cursor-pointer"
			>
				<img src="/assets/imgs/logo-close.svg" alt="" />
			</button>

			<div
				class="w-full h-48 rounded-[15px] overflow-hidden flex justify-center items-center flex-shrink-0 sm:h-56 md:h-64"
			>
				<img
					id="modal-project-image"
					src=""
					alt="Imagen del proyecto"
					class="w-full h-full object-cover hidden"
				/>
				<p
					id="modal-project-placeholder"
					class="hidden text-primary-500 font-semibold text-xl xl:text-[14px]"
				>
					En proceso
				</p>
			</div>

			<div class="w-full flex flex-col items-center gap-y-3">
				<p
					id="modal-project-title"
					class="text-neutral-500 text-xl text-center font-semibold lg:text-2xl"
				>
				</p>
				<p
					id="modal-project-description"
					class="text-neutral-600 text-sm text-center md:text-base xl:text-[12px]"
				>
				</p>
			</div>

			<a
				id="modal-project-link"
				href="#"
				target="_blank"
				class="flex w-full mt-2 px-4 py-3 bg-primary-500 rounded-[10px] text-sm font-medium items-center justify-center text-neutral-500 duration-300 hover:bg-primary-600 transition-all hover:scale-105 md:text-base flex-shrink-0 xl:text-[14px] xl:py-2"
			>
				Ver en GitHub
				<img src="/assets/imgs/github.svg" class="ml-2 size-[18px]" alt="" />
			</a>
		</div>
	</div>
</section>

<script>
	import { setupSmartScroll } from "../../scripts/smart-scroll";
	import { setupCarousel } from "../../scripts/carousel";
	import { setupModal } from "../../scripts/modal";

	setupCarousel("projects-scroll-container", "project-dots-container", ".project-card");

	const modalImage = document.getElementById("modal-project-image") as HTMLImageElement | null;
	const modalPlaceholder = document.getElementById("modal-project-placeholder");
	const modalTitle = document.getElementById("modal-project-title");
	const modalDescription = document.getElementById("modal-project-description");
	const modalLink = document.getElementById("modal-project-link") as HTMLAnchorElement | null;

	setupModal({
		modalId: "project-modal-template",
		openSelector: ".open-project-modal-btn",
		closeId: "close-project-modal-btn",
		cardSelector: ".project-card",
		label: "proyectos",
		fill: (card) => {
			const imageSrc = card.querySelector<HTMLImageElement>(".project-image")?.src; // .src solo existe en <img>
			const titleText = card.querySelector(".project-title")?.textContent;
			const descriptionText = card.querySelector(".project-description")?.textContent;
			const projectUrl = card.dataset.projectUrl;

			if (imageSrc && modalImage && modalPlaceholder) {
				// Si hay imagen, la mostramos y ocultamos el texto
				modalImage.src = imageSrc;
				modalImage.classList.remove("hidden");
				modalPlaceholder.classList.add("hidden");
			} else if (modalImage && modalPlaceholder) {
				// Si no hay imagen, ocultamos la imagen y mostramos el texto
				modalImage.classList.add("hidden");
				modalPlaceholder.classList.remove("hidden");
			}

			if (modalTitle) modalTitle.textContent = titleText || "Sin título";
			if (modalDescription) modalDescription.textContent = descriptionText || "Sin descripción.";
			if (modalLink) {
				modalLink.href = projectUrl || "#";
				// Ocultar el botón si no hay URL
				modalLink.style.display = projectUrl && projectUrl !== "#" ? "flex" : "none";
			}
		},
	});

	setupSmartScroll("projects-scroll-container");
</script>
