---
import { education, experience } from '../../data/experience';

// Paridad con el legacy: cada columna tiene pequeñas diferencias de clases
const columns = [
	{
		id: 'section-educacion',
		heading: 'EDUCACION',
		items: education,
		wrapperClass:
			'md:gap-y-[32px] lg:gap-y-[24px] 2xl:gap-y-[32px] xl:w-fit',
		glowOpacity: 'sm:opacity-30',
		headingClass: 'leading-[34px]',
	},
	{
		id: 'section-experiencia',
		heading: 'EXPERIENCIA',
		items: experience,
		wrapperClass:
			'md:gap-y-[32px] xl:gap-y-[24px] 2xl:gap-y-[32px] xl:w-fit',
		glowOpacity: 'sm:opacity-20',
		headingClass: 'leading-[9.5vw]',
	},
];
---

<section
	id="experiencias"
	class="relative py-10 flex flex-col gap-y-8 lg:px-12 xl:px-24 lg:h-[100vh]"
>
	<div
		class="absolute z-[-1] w-[80%] h-[80%] top-0 left-0 right-0 bottom-0 m-auto rounded-full [background-image:radial-gradient(ellipse_at_center,_#4124AA_0%,_#2A1672_36%,_#21115B_63%,_#1B0E4A_85%,_#05030D_100%)] blur-[100px] opacity-20 sm:hidden md:flex lg:hidden"
	>
	</div>

	<article
		id="scroll-container"
		class="relative flex overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth lg:flex-row lg:overflow-x-visible lg:snap-none lg:justify-center lg:items-center lg:h-full"
	>
		{
			columns.map((col) => (
				<div
					id={col.id}
					class:list={[
						'relative flex-col gap-y-[24px] w-full flex-none snap-start flex items-center justify-center lg:w-1/2 lg:flex-grow lg:flex-shrink',
						col.wrapperClass,
					]}
				>
					<div
						class:list={[
							'hidden sm:flex sm:absolute z-[-1] sm:w-[70%] sm:h-[90%] sm:top-0 sm:left-0 sm:right-0 sm:bottom-0 sm:m-auto sm:rounded-full sm:[background-image:radial-gradient(ellipse_at_center,_#4124AA_0%,_#2A1672_36%,_#21115B_63%,_#1B0E4A_85%,_#05030D_100%)] sm:blur-3xl md:hidden lg:flex lg:w-[85%] xl:w-[90%] 2xl:w-[70%]',
							col.glowOpacity,
						]}
					>
					</div>

					<h2
						class:list={[
							'font-extrabold text-[9.5vw] text-center bg-gradient-to-t from-primary-800 to-primary-500 bg-clip-text text-transparent sm:text-[13vh] sm:leading-[13vh] md:text-[6vw] md:leading-[6vw] lg:text-start lg:text-[5.8vh] lg:leading-[5.8vh] xl:text-[6.5vh] xl:leading-[6.5vh] 2xl:text-[52px] 2xl:leading-[56px]',
							col.headingClass,
						]}
					>
						{col.heading}
					</h2>

					<div class="relative flex-1 flex flex-col items-center gap-y-[16px] w-[94%] max-w-[340px] sm:max-w-[420px] md:max-w-[490px] md:gap-y-[32px] lg:max-w-[53vh] lg:gap-y-[1.8vh] xl:max-w-[50vh] xl:gap-y-[2vh] 2xl:max-w-[44vh]">
						{col.items.map((item) => (
							<div class="relative w-full bg-secundary-700 rounded-[20px] py-[12px] pl-[16px] flex flex-col items-start gap-y-[4px] sm:gap-y-[8px] md:gap-y-[6px] md:py-[23px] md:pl-[22px] lg:py-[1.5vh] lg:gap-y-[0.35vh] xl:py-[2vh] xl:gap-y-[0.4vh] 2xl:py-[1.4vh]">
								<p class="text-primary-500 text-[12px] font-semibold sm:text-[14px] md:text-[16px] lg:text-[1.8vh]">
									{item.year}
								</p>
								<p class="text-[16px] font-bold text-neutral-500 sm:text-[18px] md:text-[20px] lg:text-[2.5vh] 2xl:text-[2vh]">
									{item.title}
								</p>
								<p class="text-[12px] text-neutral-800 font-semibold sm:text-[14px] md:text-[16px] lg:text-[1.8vh]">
									{item.place}
								</p>
							</div>
						))}
					</div>
				</div>
			))
		}
	</article>
	<article class="flex justify-center items-center gap-x-2 lg:hidden">
		<div
			id="dot-educacion"
			class="w-4 h-4 bg-primary-500 rounded-full transition-colors duration-300"
		>
		</div>
		<div
			id="dot-experiencia"
			class="w-4 h-4 bg-secundary-500 rounded-full transition-colors duration-300"
		>
		</div>
	</article>
</section>

<script>
	// === PUNTOS DE ESTADO ENTRE EDUCACIÓN Y EXPERIENCIA ===
	const scrollContainer = document.getElementById('scroll-container');
	const dotEducacion = document.getElementById('dot-educacion');
	const dotExperiencia = document.getElementById('dot-experiencia');

	const sections = [
		document.getElementById('section-educacion'),
		document.getElementById('section-experiencia'),
	];

	if (!scrollContainer || !dotEducacion || !dotExperiencia || sections.some((s) => !s)) {
		console.error(
			'Faltan elementos HTML con los IDs requeridos (scroll-container, dot-educacion, etc.).',
		);
	} else {
		const setActiveDot = (activeId: string) => {
			if (activeId === 'section-educacion') {
				dotEducacion.classList.replace('bg-secundary-500', 'bg-primary-500');
				dotExperiencia.classList.replace('bg-primary-500', 'bg-secundary-500');
			} else if (activeId === 'section-experiencia') {
				dotExperiencia.classList.replace('bg-secundary-500', 'bg-primary-500');
				dotEducacion.classList.replace('bg-primary-500', 'bg-secundary-500');
			}
		};

		// Detecta qué sección está visible; 0.9 asegura que el snap ya terminó
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) setActiveDot(entry.target.id);
				});
			},
			{ root: scrollContainer, rootMargin: '0px', threshold: 0.9 },
		);

		sections.forEach((section) => observer.observe(section!));

		// Estado inicial (igual que el legacy: Educación activa)
		dotEducacion.classList.add('bg-primary-500');
		dotExperiencia.classList.add('bg-neutral-500');
	}
</script>
