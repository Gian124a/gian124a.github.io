---
import { socialLinks } from '../../data/navigation';
import { stats } from '../../data/stats';

// Paridad con el legacy: el botón de LinkedIn es 0.2vw más grande que el resto
const isLinkedin = (label: string) => label === 'LinkedIn';
---

<section
	id="inicio"
	class="relative flex flex-col items-center pt-6 gap-y-4 md:gap-y-8 lg:justify-end lg:h-[calc(100vh_-_70px)] lg:gap-0 z-50 xl:pt-0"
>
	<!-- Contenedor de imagen y texto -->
	<article
		style="pointer-events: none"
		class="absolute top-[55px] h-fit w-full z-30 flex sm:w-[60vw] sm:top-[85px] md:w-[55vw] md:top-[80px] lg:right-0 lg:top-auto lg:bottom-[62px] lg:w-[75vh] xl:w-[84vh] xl:bottom-[25px] lg:z-40 2xl:bottom-[30px] hero-image-pointer-events-none"
	>
		<img src="/assets/imgs/image-yo.svg" alt="Yo" class="w-full h-fit object-contain" />
	</article>

	<article
		class="relative h-full flex flex-col gap-y-11 lg:justify-center lg:w-fit xl:w-full xl:px-[45px] xl:gap-0 xl:h-full"
	>
		<div
			class="w-full h-full flex flex-col items-center sm:px-[10%] md:px-[5%] lg:items-start lg:px-0 lg:gap-y-0 lg:h-fit lg:mb-10 xl:h-fit xl:mb-16"
		>
			<h1
				class="z-10 font-extrabold text-[10.5vw] leading-[11.5vw] text-center bg-gradient-to-t from-primary-800 to-primary-500 bg-clip-text text-transparent sm:text-[8.5vw] sm:leading-[9.5vw] md:text-[7.6vw] md:leading-[8vw] lg:text-[10vh] lg:leading-[9.6vh] lg:font-bold lg:text-start lg:mb-6 lg:w-[80%] xl:mb-4 xl:text-[6.5vw] xl:leading-[6vw] 2xl:mb-5"
			>
				DESARROLLADOR FRONTEND
			</h1>

			<div
				class="relative text-[4vw] z-50 mt-[calc(100%_-_105px)] w-[94%] text-center sm:mt-[calc(70%_-_80px)] sm:text-[4.7vh] md:text-[2.2vw] md:mt-[calc(60%_-_90px)] md:w-[70%] lg:mt-0 lg:text-[2vh] lg:text-start lg:w-[45%] lg:mb-7 xl:w-[35%] xl:mb-6 2xl:w-[30%] 2xl:text-[1.6vh] 2xl:mb-8"
			>
				<p class="text-neutral-500">
					Mi nombre es Gianfranco Muñoz, TSU en Informática y desarrollador frontend con
					especialización en el desarrollo de aplicaciones móviles híbridas utilizando Flutter y
					Dart.
				</p>
			</div>

			<!-- Botón -->
			<div class="mt-10 flex justify-center items-center lg:justify-start lg:mt-0">
				<a
					href="#sobre-mi"
					class="flex px-[18px] py-[12px] bg-primary-500 rounded-[100px] text-[14px] font-medium items-center text-neutral-500 duration-300 hover:bg-primary-600 transition-all hover:scale-[1.03] sm:text-[16px] sm:px-[22px] md:text-[16px] md:py-[13px] lg:text-[14px] lg:py-[10px] lg:px-[14px] xl:text-[12px] 2xl:text-[14px] 2xl:py-[12px]"
				>
					Conóceme más
					<img
						src="/assets/icons/arrow-right.svg"
						class="ml-2 size-[20px] md:size-[24px] lg:size-[20px] xl:size-[16px] 2xl:size-[18px]"
						alt=""
					/>
				</a>
			</div>
		</div>

		<div
			class="flex justify-around items-center px-[5px] sm:px-[10%] sm:justify-center sm:gap-x-[25px] lg:w-fit lg:px-0 lg:gap-x-3 lg:absolute lg:bottom-0 xl:bottom-3"
		>
			{
				socialLinks.map((social) => (
					<a
						href={social.href}
						class:list={[
							'bg-secundary-600 rounded-full flex justify-center items-center sm:w-[8vw] sm:h-[8vw] lg:w-[6.5vh] lg:h-[6.5vh] xl:w-[7vh] xl:h-[7vh] 2xl:w-[6vh] 2xl:h-[6vh] hover:bg-secundary-700 hover:transition-all hover:scale-[1.07] duration-300',
							isLinkedin(social.label) ? 'w-[13.2vw] h-[13.2vw]' : 'w-[13vw] h-[13vw]',
						]}
					>
						<img
							src={social.icon}
							alt={social.label}
							class:list={[
								'text-neutral-500 sm:size-[4vw] lg:size-[3.3vh] 2xl:size-[3vh]',
								isLinkedin(social.label) ? 'size-[7vw]' : 'size-[6.8vw]',
							]}
						/>
					</a>
				))
			}
		</div>
	</article>

	<article
		class="bg-secundary-900 flex flex-col gap-y-5 lg:gap-y-4 lg:mt-3 xl:w-full xl:gap-y-[10px] xl:mt-0 lg:h-[17vh] justify-between z-50 2xl:h-[14vh]"
	>
		<div class="bg-[linear-gradient(to_right,#0C0B0D,#403B45,#403B45,#0C0B0D)] h-[2px] w-full"></div>

		<div
			class="flex justify-between flex-wrap gap-y-4 sm:px-[5%] sm:gap-x-2 lg:gap-x-0 lg:px-0 xl:justify-around"
		>
			{
				stats.map((stat) => (
					<div class="relative flex justify-between items-center w-[50%] px-2 gap-x-[7px] sm:w-[45%] sm:justify-start sm:gap-x-[12px] lg:justify-center lg:w-[22%] lg:gap-x-[7px] xl:w-fit 2xl:gap-x-[10px]">
						<h2 class="text-[8vw] font-bold text-neutral-500 sm:text-[7vw] lg:text-[6.6vh] 2xl:text-[6vh]">
							{stat.value}
						</h2>
						<div class="sm:w-[70%] md:w-[60%] lg:w-fit xl:w-[55%]">
							<p class="text-[3.3vw] text-neutral-500 sm:text-[2.4vw] md:text-[2vw] lg:text-[2vh] 2xl:text-[1.6vh]">
								{stat.label}
							</p>
						</div>
					</div>
				))
			}
		</div>
		<div class="bg-[linear-gradient(to_right,#0C0B0D,#403B45,#403B45,#0C0B0D)] h-[2px] w-full"></div>
	</article>
</section>
