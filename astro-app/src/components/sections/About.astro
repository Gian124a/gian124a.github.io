---
import { aboutTags } from '../../data/about';
---

<section
	id="sobre-mi"
	class="relative pt-10 px-6 flex flex-col gap-y-5 z-50 md:gap-y-7 lg:h-[100vh] lg:flex-row lg:gap-x-10 lg:items-center lg:pt-0 xl:gap-x-0"
>
	<div
		class="absolute z-[-1] w-full h-full top-0 left-0 right-0 bottom-0 m-auto rounded-full [background-image:radial-gradient(ellipse_at_center,_#4124AA_0%,_#2A1672_36%,_#21115B_63%,_#1B0E4A_85%,_#05030D_100%)] blur-3xl opacity-30 sm:w-[80%] md:w-full lg:h-[80%] 2xl:w-[90%]"
	>
	</div>

	<article
		class="text-[9vw] font-semibold text-neutral-500 flex justify-center items-center sm:text-[12vh] md:text-[5vw] lg:hidden"
	>
		<h1>SOBRE MI</h1>
	</article>

	<article class="flex justify-center lg:w-[50%]">
		<img
			class="w-[65vw] sm:w-[45vw] md:w-[40vw] md:max-w-[450px] lg:max-w-none lg:w-[60vh] 2xl:w-[68%] 2xl:max-w-[520px]"
			src="/assets/imgs/image-yo-section2.svg"
			alt="Sobre mi"
		/>
	</article>

	<article
		class="flex flex-col items-center gap-y-[22px] md:gap-y-[30px] lg:w-[50%] lg:items-start lg:gap-y-[15px] 2xl:gap-y-[24px]"
	>
		<article
			class="hidden font-semibold text-neutral-500 lg:flex lg:justify-center lg:items-center lg:text-[3.5vh] lg:leading-[3.5vh] xl:text-[3.7vh] 2xl:text-[3vh] 2xl:leading-[3vh]"
		>
			<h1>SOBRE MI</h1>
		</article>
		<div class="sm:w-[80%] lg:w-full xl:w-[90%] 2xl:w-[90%]">
			<h2
				class="font-extrabold text-[7vw] leading-[8vw] text-center bg-gradient-to-t from-primary-800 to-primary-500 bg-clip-text text-transparent sm:text-[11vh] sm:leading-[12vh] md:text-[5vw] md:leading-[6vw] lg:text-start lg:text-[5.3vh] lg:leading-[5.8vh] xl:text-[5.8vh] xl:leading-[6.2vh] 2xl:text-[5vh] 2xl:leading-[5.3vh]"
			>
				HOLA, MI NOMBRE ES GIANFRANCO MUÑOZ
			</h2>
		</div>

		<div class="sm:w-[80%] lg:w-[90%] xl:w-[95%] 2xl:w-[90%]">
			<p
				class="text-neutral-500 text-center text-[3.8vw] sm:text-[5vh] md:text-[2.2vw] lg:text-justify lg:text-[2vh] xl:w-[80%] 2xl:w-[70%] 2xl:text-[1.6vh]"
			>
				Soy un Desarrollador Frontend que, a mis 21 años, ha forjado una especialización concreta
				en el desarrollo móvil. Como TSU en Informática, egresado del Instituto Universitario
				Jesús Obrero, he dedicado el último año a consolidar mis habilidades en esta área. Me
				caracterizo por ser una persona altamente comprometida con mis proyectos, innovadora en mi
				enfoque creativo y siempre responsable en la ejecución de mis tareas.
			</p>
		</div>
		<div
			class="flex justify-center flex-wrap gap-[8px] sm:w-[60%] sm:gap-[10px] md:w-[80%] lg:w-full lg:justify-start xl:w-[70%] 2xl:w-[50%]"
		>
			{
				aboutTags.map((tag) => (
					<span class="bg-primary-800 flex items-center py-[6px] px-[14px] text-[14px] text-neutral-500 font-semibold rounded-[10px] sm:text-[16px] sm:px-[16px] sm:py-[7px] md:text-[18px] md:px-[18px] md:py-[8px] lg:px-[17px] lg:py-[6px] lg:text-[2.1vh] 2xl:text-[1.7vh]">
						{tag}
					</span>
				))
			}
		</div>

		<!-- Botón -->
		<div class="flex justify-center items-center lg:justify-start lg:mt-0">
			<a
				href="/assets/imgs/CV.pdf"
				class="flex px-[18px] py-[12px] bg-primary-500 rounded-[100px] text-[14px] font-medium items-center text-neutral-500 duration-300 hover:bg-primary-600 transition-all hover:scale-[1.03] sm:text-[16px] sm:px-[22px] md:text-[16px] md:py-[13px] lg:text-[14px] lg:py-[10px] lg:px-[14px] xl:text-[12px] 2xl:text-[14px] 2xl:py-[12px]"
			>
				Visualizar CV
				<img
					src="/assets/icons/eyes.svg"
					class="ml-2 size-[20px] md:size-[24px] lg:size-[20px] xl:size-[16px] 2xl:size-[18px]"
					alt=""
				/>
			</a>
		</div>
	</article>
</section>
