---
import { socialLinks } from '../../data/navigation';
import { contactInfo, formFields } from '../../data/contact';

// Paridad con el legacy: el botón de LinkedIn es 0.2vw más grande que el resto
const isLinkedin = (label: string) => label === 'LinkedIn';
---

<section
	id="contacto"
	class="relative mt-10 flex flex-col gap-y-[32px] items-center lg:gap-y-[42px] xl:flex-row xl:h-[calc(100vh_-_70px)] xl:px-[70px] xl:justify-between 2xl:px-[140px]"
>
	<article
		class="flex flex-col gap-y-[28px] items-center lg:gap-y-[42px] xl:gap-y-[24px] xl:flex-1 xl:items-start"
	>
		<div
			class="flex flex-col gap-y-3 px-7 items-center lg:order-1 lg:gap-y-5 xl:gap-y-3 xl:items-start xl:p-0 xl:order-1"
		>
			<h2
				class="font-extrabold text-[9.5vw] leading-[9.5vw] text-center bg-gradient-to-t from-primary-800 to-primary-500 bg-clip-text text-transparent sm:text-[13vh] sm:leading-[13vh] md:text-[6vw] md:leading-[6vw] lg:text-start lg:text-[5.8vh] lg:leading-[5.8vh] xl:text-[6.5vh] xl:leading-[6.5vh] 2xl:text-[52px] 2xl:leading-[56px]"
			>
				CONTACTAME
			</h2>
			<div class="relative lg:w-[80%] xl:w-[70%] 2xl:w-[60%]">
				<p
					class="text-neutral-500 text-center text-[3.8vw] sm:text-[5vh] md:text-[2.2vw] lg:text-center lg:text-[2vh] xl:text-start 2xl:text-[1.6vh]"
				>
					Si tienes una idea para una aplicación móvil, contáctanos. Analizaremos tu concepto y lo
					desarrollaremos. Puedes empezar llenando el formulario, enviando un correo, o por
					WhatsApp.
				</p>
			</div>
		</div>
		<div
			class="flex flex-col gap-y-[15px] md:gap-y-[20px] lg:flex-row lg:gap-x-[25px] lg:order-3 xl:order-2 xl:flex-col xl:items-start xl:w-full"
		>
			{
				contactInfo.map((info) => (
					<div class="flex items-center gap-x-[15px] lg:gap-x-[15px] xl:gap-x-[10px]">
						<div class="w-[13.2vw] h-[13.2vw] bg-secundary-600 rounded-full flex justify-center items-center sm:w-[8vw] sm:h-[8vw] lg:w-[6.5vh] lg:h-[6.5vh] xl:w-[7vh] xl:h-[7vh] 2xl:w-[6vh] 2xl:h-[6vh]">
							<img
								src={info.icon}
								alt={info.label}
								class="size-[7vw] text-neutral-500 lg:size-[3.3vh] 2xl:size-[3vh]"
							/>
						</div>
						<p class="text-neutral-500 text-center text-[3.8vw] sm:text-[5vh] md:text-[2.5vw] lg:text-[2vh] 2xl:text-[1.6vh]">
							{info.text}
						</p>
					</div>
				))
			}
		</div>
		<div
			class="w-fit flex flex-col px-7 sm:px-[10%] gap-y-[15px] lg:order-2 xl:order-3 xl:w-full xl:items-start xl:px-0 xl:justify-start"
		>
			<p
				class="text-neutral-500 text-start text-[4vw] sm:text-[5vh] md:text-[2.5vw] lg:text-[2.2vh] 2xl:text-[1.6vh]"
			>
				SIGUEME
			</p>
			<div class="flex justify-around items-center sm:justify-center gap-x-[10px]">
				{
					socialLinks.map((social) => (
						<a
							href={social.href}
							class:list={[
								'bg-secundary-600 rounded-full flex justify-center items-center sm:w-[8vw] sm:h-[8vw] lg:w-[6.5vh] lg:h-[6.5vh] xl:w-[7vh] xl:h-[7vh] 2xl:w-[6vh] 2xl:h-[6vh] hover:bg-secundary-700 hover:transition-all hover:scale-[1.07] duration-300',
								isLinkedin(social.label) ? 'w-[13.2vw] h-[13.2vw]' : 'w-[13vw] h-[13vw]',
							]}
						>
							<img
								src={social.icon}
								alt={social.label}
								class:list={[
									'text-neutral-500 lg:size-[3.3vh] 2xl:size-[3vh]',
									isLinkedin(social.label) ? 'size-[7vw]' : 'size-[6.8vw]',
								]}
							/>
						</a>
					))
				}
			</div>
		</div>
	</article>
	<article class="relative w-full lg:w-[90%] xl:w-[50%]">
		<div
			class="flex absolute w-[90%] h-[90%] sm:w-full sm:h-full z-[-1] top-0 left-0 right-0 bottom-0 m-auto sm:rounded-[10px] [background-image:radial-gradient(ellipse_at_center,_#4124AA_0%,_#2A1672_36%,_#21115B_63%,_#1B0E4A_85%,_#05030D_100%)] blur-3xl opacity-50"
		>
		</div>

		<form
			id="contact-form"
			action="https://formspree.io/f/xrbywavq"
			method="POST"
			class="bg-secundary-800 p-[32px] flex flex-col gap-y-[15px] rounded-[30px] sm:flex-row sm:flex-wrap sm:justify-between sm:gap-y-[20px] sm:p-[50px] xl:p-[30px] xl:gap-y-[10px] 2xl:p-[50px] 2xl:gap-y-[25px]"
			novalidate
		>
			{
				formFields.map((field) => (
					<div class="flex flex-col gap-y-[8px] sm:w-[48%]">
						<label
							for=""
							class="font-medium text-[16px] text-neutral-500 sm:text-[18px] xl:text-[14px]"
						>
							{field.label}
						</label>
						<input
							type={field.type}
							inputmode={field.inputmode}
							name={field.name}
							class="bg-secundary-600 h-[48px] pl-[15px] text-[14px] rounded-[10px] outline-0 text-neutral-500 placeholder:text-neutral-700 sm:h-[52px] sm:text-[16px] xl:text-[14px] xl:h-[42px]"
							placeholder={field.placeholder}
						/>
						<div class="error-message text-red-500 text-xs" />
					</div>
				))
			}
			<div class="flex flex-col gap-y-[8px] sm:w-full">
				<label
					for=""
					class="font-medium text-[16px] text-neutral-500 md:text-[18px] xl:text-[14px]"
				>
					Mensaje
				</label>
				<textarea
					name="message"
					class="bg-secundary-600 h-[250px] p-[15px] text-[14px] rounded-[10px] outline-0 text-neutral-500 placeholder:text-neutral-700 resize-none sm:text-[16px] xl:text-[14px] xl:h-[200px] 2xl:h-[230px]"
					placeholder="Escribe un mensaje de lo que desees..."
				></textarea>
				<div class="error-message text-red-500 text-xs"></div>
			</div>
			<div class="sm:w-full flex flex-col items-start gap-y-2">
				<button
					type="submit"
					class="w-full h-[48px] text-neutral-500 bg-primary-500 rounded-[10px] text-[14px] cursor-pointer sm:text-[16px] sm:h-[52px] lg:w-fit lg:px-[25px] xl:h-[42px] xl:text-[14px] hover:bg-primary-600 transition-colors duration-300 disabled:bg-primary-800 disabled:cursor-not-allowed"
				>
					Enviar mensaje
				</button>
			</div>
		</form>
	</article>
</section>
