---
import { navLinks, socialLinks } from '../data/navigation';
---

<footer class="mt-25 bg-secundary-800 text-neutral-500 py-12 px-4 sm:px-8 lg:px-12 lg:mt-16">
	<div class="max-w-6xl mx-auto flex flex-col items-center gap-y-8">
		<!-- Logo -->
		<h1
			class="font-extrabold text-[28px] bg-gradient-to-t from-primary-800 to-primary-500 bg-clip-text text-transparent sm:text-[36px]"
		>
			PORTFOLIO
		</h1>

		<!-- Enlaces de Navegación -->
		<div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-neutral-400">
			{
				navLinks.map((link) => (
					<a href={link.href} class="hover:text-primary-500 transition-colors">
						{link.label}
					</a>
				))
			}
		</div>

		<!-- Iconos de Redes Sociales -->
		<div class="flex justify-center items-center gap-x-4">
			{
				socialLinks.map((social) => (
					<a
						href={social.href}
						class="w-10 h-10 bg-secundary-600 rounded-full flex justify-center items-center hover:bg-secundary-700 hover:scale-105 transition-transform"
					>
						<img src={social.icon} alt={social.label} class="w-5 h-5" />
					</a>
				))
			}
		</div>

		<!-- Copyright -->
		<p class="text-xs text-center text-neutral-600 mt-4">
			&copy; 2025 Gianfranco Muñoz. Todos los derechos reservados.
		</p>
	</div>
</footer>
