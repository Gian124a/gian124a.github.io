---
import { navLinks } from '../data/navigation';

const baseLink =
	'relative z-10 px-[40px] py-[13px] sm:px-[45px] sm:py-[15px] md:px-[50px] md:py-[18px] text-neutral-500 text-[14px]';
const desktopLink = 'lg:px-[17px] lg:py-[6px] lg:rounded-[100px]';

// Las clases difieren por posición en el legacy (paridad visual)
function linkClass(index: number, mobileOnly?: boolean) {
	if (mobileOnly) return `${baseLink} lg:hidden`;
	if (index === navLinks.filter((l) => !l.mobileOnly).length - 1) {
		return `${baseLink} ${desktopLink} duration-300 lg:transition-all`;
	}
	return `${baseLink} ${desktopLink} transition-all duration-300 lg:mr-2`;
}
---

<nav
	class="fixed top-[84px] right-3 z-[110] w-fit sm:absolute lg:absolute lg:top-0 lg:left-0 lg:right-0 lg:mx-auto lg:flex lg:justify-center lg:items-center lg:h-[70px]"
>
	<ul
		id="menu-container"
		class="relative flex flex-col items-center p-[6px] overflow-hidden rounded-[12px] bg-gradient-to-b from-secundary-800 to-secundary-600 backdrop-blur-xl shadow-lg transition-all duration-500 ease-in-out lg:flex-row lg:p-1 lg:rounded-full lg:border lg:border-neutral-700 lg:backdrop-blur-sm"
	>
		<!-- Fondo animado -->
		<span
			id="active-bg"
			class="absolute z-[1] top-0 left-0 right-0 mx-auto rounded-[10px] bg-secundary-500/70 backdrop-blur-md border border-neutral-600/30 shadow-[inset_0_0_4px_rgba(106,102,167,0.5)] transition-all duration-500 ease-in-out lg:top-0 lg:bottom-0 lg:left-0 lg:right-auto lg:m-auto lg:h-[calc(100%-8px)] lg:w-[80px] lg:rounded-[100px] lg:bg-secundary-600 lg:border-neutral-700 lg:shadow-[inset_0_0_6px_rgba(106,102,167,0.7)]"
		></span>

		<!-- Botones -->
		{
			navLinks.map((link, i) => (
				<a href={link.href} class={linkClass(i, link.mobileOnly)}>
					{link.label}
				</a>
			))
		}
	</ul>
</nav>

<script>
	// === MENÚ, FONDO ACTIVO, SCROLLSPY Y SCROLL SUAVE ===
	const menu = document.getElementById('menu-container') as HTMLElement;
	const activeBg = document.getElementById('active-bg') as HTMLElement;
	const links = menu.querySelectorAll<HTMLAnchorElement>('a');
	const buttonMenu = document.getElementById('button-menu') as HTMLElement;
	let userClicked = false;
	let clickTimeout: number;

	// --- Controla el movimiento del fondo activo ---
	function moveBgTo(link: HTMLAnchorElement) {
		// Determina si el menú es vertical (móvil) u horizontal (escritorio/móvil horizontal)
		// basándose en el estilo computado, que es más fiable que el ancho de la ventana.
		const isMobile = window.getComputedStyle(menu).flexDirection === 'column';

		const offset = isMobile ? link.offsetTop : link.offsetLeft;
		const size = isMobile ? link.offsetHeight : link.offsetWidth;

		activeBg.style.transform = isMobile ? `translateY(${offset}px)` : `translateX(${offset}px)`;

		if (isMobile) {
			activeBg.style.height = `${size}px`;
			activeBg.style.width = `calc(100% - 8px)`; // margen visual lateral
		} else {
			activeBg.style.width = `${size}px`;
			activeBg.style.height = `calc(100% - 8px)`;
		}
	}

	// --- Marca un link como activo ---
	function activateLink(link: HTMLAnchorElement) {
		links.forEach((l) => l.classList.remove('active', 'pointer-events-none'));
		link.classList.add('active', 'pointer-events-none');
		moveBgTo(link);
	}

	// --- Scroll suave a la sección con offset para el header ---
	function scrollToSection(targetId: string) {
		const targetSection = document.getElementById(targetId);
		if (!targetSection) return;

		const header = document.querySelector('header');
		let headerOffset = 0;

		// Solo compensamos la altura del header si es 'fixed' (único caso en que se superpone)
		if (header && window.getComputedStyle(header).position === 'fixed') {
			headerOffset = header.offsetHeight;
		}

		const elementPosition = targetSection.getBoundingClientRect().top;
		const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

		window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
	}

	// --- Evento de clic en los links ---
	links.forEach((link) => {
		link.addEventListener('click', (e) => {
			e.preventDefault();

			// Desactiva temporalmente el scrollspy mientras dura el scroll suave
			userClicked = true;
			clearTimeout(clickTimeout);
			clickTimeout = window.setTimeout(() => (userClicked = false), 1000);

			activateLink(link);
			scrollToSection(link.getAttribute('href')!.substring(1));

			// Si está en móvil, cierra el menú al seleccionar
			if (window.innerWidth < 1024) {
				menu.classList.remove('open');
			}
		});
	});

	// --- Actualiza el link activo mientras se hace scroll ---
	function updateActiveLinkOnScroll() {
		const sections = Array.from(links)
			.map((link) => {
				const id = link.getAttribute('href')?.substring(1);
				return id ? document.getElementById(id) : null;
			})
			.filter(Boolean) as HTMLElement[];

		const observer = new IntersectionObserver(
			(entries) => {
				if (userClicked) return;

				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const correspondingLink = menu.querySelector<HTMLAnchorElement>(
							`a[href="#${entry.target.id}"]`,
						);
						if (correspondingLink) activateLink(correspondingLink);
					}
				});
			},
			// Activa cuando el centro de la sección cruza el centro de la pantalla
			{ root: null, rootMargin: '-50% 0px -50% 0px', threshold: 0 },
		);

		sections.forEach((section) => observer.observe(section));
	}

	// --- Mueve el fondo al primer elemento al cargar ---
	window.addEventListener('load', () => {
		activateLink(links[0]);
		updateActiveLinkOnScroll();
	});

	// --- Reajusta la posición al redimensionar ---
	window.addEventListener('resize', () => {
		const activeLink = document.querySelector<HTMLAnchorElement>('a.active') || links[0];
		moveBgTo(activeLink);
	});

	// --- Abre / Cierra menú en móviles ---
	buttonMenu.addEventListener('click', () => {
		menu.classList.toggle('open');
	});
</script>
