---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio (Astro)">
	<main class="p-8 text-neutral-50">
		<h1 class="text-4xl font-bold">Fundaciones — Poppins</h1>
		<div class="mt-6 flex gap-2">
			<span class="size-12 bg-neutral-500"></span>
			<span class="size-12 bg-primary-500"></span>
			<span class="size-12 bg-secundary-500"></span>
		</div>
		<img src="/assets/icons/arrow-down.svg" alt="" class="mt-6 size-8" />
	</main>
</Layout>
